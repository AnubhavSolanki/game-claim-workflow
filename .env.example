# Chrome Configuration
CHROME_USER_DATA_DIR=./chrome-data
HEADLESS=false

# Platform Enable/Disable (true/false)
ENABLE_AMAZON=true
ENABLE_EPIC=true

# Credentials
LEGACY_GAMES_EMAIL=your-email@example.com

# Discord Webhook (see docs/discord-webhook-setup.md)
DISCORD_WEBHOOK_URL=

# Scheduling (cron expression - default: daily at 2 PM)
CRON_SCHEDULE=0 14 * * *
